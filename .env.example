# FMCG Vendora — Environment Configuration Example
# Copy this file to backend/.env and update the values with your local/production settings.

# Database Configuration
DB_HOST=localhost
DB_NAME=vendora_fmcg
DB_USER=root
DB_PASS=

# Application Configuration
APP_ENV=development
APP_URL="http://localhost/fmcg-vendora/backend"

# Mailer SMTP Configuration (e.g. Gmail App Password)
# Set your SMTP credentials below (leave blank to log emails locally to backend/uploads/mail_log.html)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM_NAME="Vendora FMCG"
SMTP_FROM_EMAIL="no-reply@vendora.lk"

# Portal URLs for Links & Redirects
FRONTEND_RETAILER_URL="http://localhost:5176"
FRONTEND_DISTRIBUTOR_URL="http://localhost:5174"
FRONTEND_DRIVER_URL="http://localhost:5175"
FRONTEND_ADMIN_URL="http://localhost:5173"

# Payment Gateway Configuration (Mock / Sandbox)
GATEWAY_MERCHANT_ID="VENDORA_MOCK_MERCHANT"
GATEWAY_SECRET="vendora_mock_secret_key_2026"
GATEWAY_NAME="Vendora Mock Gateway (Sandbox)"
